# =============================================================

# -------------------------------------------------------
# 【最重要】DB接続・認証情報（全ディレクトリ共通）
# -------------------------------------------------------
php/db_connect.php
php/config.php
rireki/basic/php/db_connect.php
rireki/kaigo/php/db_connect.php
**/db_connect.php
sftp.json
.sftpignore
.env
.env.*
*.env
*.pem
*.key
*.p12
*.pfx
google-credentials.json
firebase-config.json
client_secret.json
aws-credentials.csv
*secret*
*credential*
*_secret.json
*_secret.php

# -------------------------------------------------------
# 【重要】セキュリティ設定（本番サーバー専用）
# -------------------------------------------------------
.htaccess

# -------------------------------------------------------
# PHPコンフィグ系（DB/APIキーを含む可能性あり）
