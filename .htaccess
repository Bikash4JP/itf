# Enable cache control
   <IfModule mod_expires.c>
       ExpiresActive On

       # Images
       ExpiresByType image/jpeg "access plus 1 month"
       ExpiresByType image/png "access plus 1 month"
       ExpiresByType image/webp "access plus 1 month"
       ExpiresByType image/gif "access plus 1 month"

       # CSS and JavaScript
       ExpiresByType text/css "access plus 1 month"
       ExpiresByType application/javascript "access plus 1 month"
       ExpiresByType text/javascript "access plus 1 month"

       # Fonts
       ExpiresByType font/woff2 "access plus 1 month"
       ExpiresByType application/font-woff2 "access plus 1 month"
   </IfModule>

   # Set Cache-Control headers
   <IfModule mod_headers.c>
       <FilesMatch "\.(jpg|jpeg|png|gif|webp|css|js|woff2)$">
           Header set Cache-Control "public, max-age=2592000"
       </FilesMatch>
   </IfModule>

   RewriteEngine On

# If you already have rules, keep them; just add these BEFORE other generic rewrites.
# Send /rirek and anything under it to Laravel's public/ front controller
RewriteRule ^rirek/?$ rirek/public/ [L]
RewriteRule ^rirek/(.*)$ rirek/public/$1 [L]
